{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(scripts/build.bat:*)",
      "Bash(cmd //c scripts\\build.bat:*)",
      "Bash(ctest:*)",
      "Bash(cmake:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(uv run:*)",
      "Bash(uv pip:*)",
      "Bash(python -I:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python -I .claude/hooks/guard.py" }]
      }
    ]
  }
}
